<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>IdentityProvider.Auth</PackageId>
        <Version>1.0.0</Version>
        <Description>JWT authentication middleware for microservices built on top of IdentityProvider. Configures HS256 bearer validation and an optional per-request revocation check via the IdentityProvider authentication endpoint.</Description>
        <Authors>Nikshith Reddy Byreddy</Authors>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    </ItemGroup>

</Project>
